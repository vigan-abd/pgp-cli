{
  "name": "pgp-cli",
  "version": "1.0.2",
  "description": "Simple cli tool for encrypting and decrypting openpgp messages",
  "main": "index.js",
  "bin": {
    "pgp-cli": "bin/pgp-cli.js"
  },
  "scripts": {
    "format": "bfx-lint-js . --fix",
    "lint": "bfx-lint-js .",
    "test": "npm run lint && npm run unit",
    "unit": "NODE_ENV=test brittle-node test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigan-abd/pgp-cli.git"
  },
