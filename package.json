    "cli"
  ],
  "author": {
    "name": "vigan.abd",
    "email": "vigan.abd@gmail.com"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/vigan-abd/pgp-cli/issues"
  },
  "homepage": "https://github.com/vigan-abd/pgp-cli#readme",
  "dependencies": {
    "openpgp": "^5.11.3",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@bitfinex/lint-js": "^1.1.0",
    "brittle": "^4.5.0"
